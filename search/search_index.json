{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u4e3b\u9875","text":"Lady C <p> \u6b22\u8fce\u6765\u5230\u6211\u7684\u4e2a\u4eba\u7a7a\u95f4 </p>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>Hello\uff01\u6b22\u8fce\u6765\u5230Lady C\u7684\u4e2a\u4eba\u7a7a\u95f4\u3002</p> <p>\u8fd9\u91cc\u4e3b\u8981\u7528\u6765\u8bb0\u5f55\u751f\u6d3b\u548c\u5206\u4eab\u7ecf\u9a8c\u8d34\u3002</p> <p>\u4e0b\u9762\u662f\u6211\u7684\u788e\u788e\u5ff5\u81ea\u6211\u4ecb\u7ecd\u3002</p> <p>\u672c\u4eba\u6027\u522b\u5973\uff0c\u6765\u81ea\u5c71\u4e1c\u6f4d\u574a\uff08\u90a3\u4e2a\u6240\u6709\u4eba\u90fd\u77e5\u9053\u98ce\u7b5d\u5f88\u51fa\u540d\u7684\u57ce\u5e02\uff09\u3002\u6211\u7684\u7231\u597d\u662f\u770b\u7535\u5f71\u548c\u542c\u6b4c\uff0c\u8fd0\u52a8\u559c\u6b22\u8dd1\u6b65\uff0c\u4e5f\u60f3\u4f53\u9a8c\u4e00\u4e0b\u5f92\u6b65\uff0c\u7a7a\u95f2\u7684\u65f6\u5019\u559c\u6b22\u65c5\u6e38\u3002</p> <p>\u6211\u559c\u6b22\u4ea4\u670b\u53cb\uff0c\u6211\u7684mbti\u662finfj\uff0c\u80fd\u591f\u503e\u542c\u670b\u53cb\u7684\u70e6\u607c\u3002\u6211\u5b66\u8fc7\u6cd5\u8bed\uff0c\u5982\u679c\u5bf9\u6cd5\u8bed\u611f\u5174\u8da3\u7684\u540c\u5b66\u6211\u53ef\u4ee5\u6559\u4f60\u3002</p> <p>\uff08\u5176\u4ed6\u5f85\u8865\u5145\u2026\u2026\uff09</p>"},{"location":"experience/","title":"\u7ecf\u9a8c\u8d34","text":"<p>\u8fd9\u91cc\u662f\u6211\u6574\u7406\u7684\u5404\u7c7b\u7ecf\u9a8c\u5206\u4eab\uff0c\u6b22\u8fce\u9605\u8bfb\u3002</p>"},{"location":"experience/#_2","title":"\u6587\u7ae0\u5217\u8868","text":"<ul> <li>\u4fdd\u7814\u7ecf\u9a8c\u8d34 \u2014\u2014 \u6211\u7684\u4fdd\u7814\u51c6\u5907\u4e0e\u53c2\u8425\u7ecf\u5386</li> <li>\u96c5\u601d\u5907\u8003\u7ecf\u9a8c\u8d34 \u2014\u2014 \u542c\u529b\u3001\u9605\u8bfb\u3001\u5199\u4f5c\u3001\u53e3\u8bed\u56db\u79d1\u5907\u8003\u7ecf\u9a8c</li> </ul>"},{"location":"experience/baoyan/","title":"\u4fdd\u7814\u7ecf\u9a8c\u8d34","text":""},{"location":"experience/baoyan/#_2","title":"\u5927\u4e09\u524d\u6211\u5e72\u4e86\u4ec0\u4e48","text":"<p>\u521a\u4e0a\u5927\u4e00\uff0c\u59d0\u59d0\u8bf4\u4e86\u89e3\u4e00\u4e0b\u4fdd\u7814\u3002\u5f53\u65f6\u5e76\u4e0d\u4e86\u89e3\u5f88\u591a\uff0c\u4f46\u731c\u60f3\u4fdd\u7814\u548c\u6210\u7ee9\u80af\u5b9a\u6302\u94a9\u5427\u3002\u5927\u4e00\u4e0a\u5b66\u671f\u6210\u7ee98/49\uff0c\u7565\u5fae\u770b\u4e86\u4e00\u70b9\u522b\u4eba\u7684\u7ecf\u9a8c\u8d34\uff0c\u89c9\u5f97\u8fd9\u4e2a\u6210\u7ee9\u5c31\u662f\u8fb9\u7f18\u4eba\uff0c\u6700\u591a\u4fdd\u672c\u6821\uff0c\u4e8e\u662f\u5f00\u59cb\u4e86\u52aa\u529b\u3001\u7126\u8651\u3001\u5feb\u4e50\u3001\u75db\u82e6\u4ea4\u7ec7\u7684\u4e24\u5e74\u534a\u5927\u5b66\u751f\u6d3b\u3002</p> <p>\u5927\u4e00\u4e0b\u5b66\u671f\u60f3\u52aa\u529b\u63d0\u9ad8\u6210\u7ee9\uff0c\u540c\u65f6\u4e86\u89e3\u4e86\u7814\u7a76\u751f\u60f3\u8981\u5b66\u7684\u65b9\u5411\uff0c\u4e86\u89e3\u4e86\u4e00\u70b9\u8003\u7814\uff0c\u8fd8\u53bb\u542c\u4e86\u4fdd\u7814\u5206\u4eab\u4f1a\uff0c\u4f46\u6700\u7ec8\u5927\u4e00\u4e00\u5e74\u7684\u6210\u7ee9\u53ea\u63d0\u4e861\u540d\uff0c\u53d8\u6210\u4e867/49\u3002</p> <p>\u6210\u7ee9\u597d\u96be\u63d0\uff0c\u4e8e\u662f\u5927\u4e8c\u5f00\u59cb\u4e0d\u518d\u60f3\u7740\u63d0\u6210\u7ee9\u548c\u4fdd\u7814\uff0c\u800c\u662f\u51b3\u5b9a\u5c06\u6765\u8fd8\u662f\u8981\u8003\u7814\u3002</p> <p>\u7531\u4e8e\u6587\u79d1\u4e13\u4e1a\u8bfe\u7a0b\u6210\u7ee9\u7ed9\u5206\u90fd\u5f88\u9ad8\uff0c\u6240\u4ee5\u6bcf\u6b21\u5404\u79cd\u5c0f\u6d4b\u5f97\u7684\u5206\u5f88\u9ad8\u65f6\uff0c\u603b\u4f1a\u544a\u8beb\u81ea\u5df1\uff0c\u4e0d\u8981\u50cf\u5927\u4e00\u7684\u65f6\u5019\u4e00\u6837\u592a\u81ea\u4ee5\u4e3a\u662f\uff0c\u522b\u4eba\u90fd\u5f88\u9ad8\u3002\u76f4\u5230\u4e00\u6b21\u5c0f\u7684\u671f\u4e2d\u8003\u8bd5\uff0c\u8001\u5e08\u662f\u5728\u5168\u73ed\u540c\u5b66\u9762\u524d\u5f55\u6210\u7ee9\uff0c\u53d1\u73b0\u5728\u5927\u5bb6\u6709\u5f88\u5927\u4e00\u90e8\u5206\u4eba\u4e0d\u53ca\u683c\uff0c\u4ee5\u53ca\u53ea\u67094\u4e2a\u4eba\u8003\u523080\u5206\u4ee5\u4e0a\u7684\u60c5\u51b5\u4e0b\uff0c\u6211\u8003\u4e8695\uff0c\u7a81\u7136\u53c8\u89c9\u5f97\u81ea\u5df1\u53c8\u6709\u4fdd\u7814\u7684\u673a\u4f1a\u4e86\u3002</p> <p>\u5927\u4e8c\u6bcf\u5929\u5f00\u5fc3\u5b66\u4e60\uff0c\u5f88\u7d2f\u4e5f\u5f88\u5feb\u4e50\uff0c\u867d\u7136\u7ecf\u5e38\u7126\u8651\uff0c\u4f46\u611f\u89c9\u81ea\u5df1\u5728\u4e00\u70b9\u70b9\u8fdb\u6b65\u3002\u6700\u540e\u5927\u4e8c\u6210\u7ee9\u662f3/47\u3002</p>"},{"location":"experience/baoyan/#_3","title":"\u5927\u4e09\u4e00\u5e74\u6211\u5e72\u4e86\u4ec0\u4e48","text":"<p>\u5927\u4e09\u4e0a\u5b66\u671f\u4e13\u4e1a\u8bfe\u591a\u4e86\u4e5f\u96be\u4e86\uff0c\u4e0a\u5b66\u671f\u4e3b\u8981\u505a\u7684\u662f\u52aa\u529b\u63d0\u6210\u7ee9\uff0c\u76ee\u6807\u662f\u5728\u590f\u4ee4\u8425\u4e4b\u524d\u628a\u524d\u4e94\u5b66\u671f\u6210\u7ee9\u63d0\u5f97\u5c3d\u91cf\u9ad8\u3002\u5e78\u8fd0\u5730\u662f\u56e0\u4e3a\u75ab\u60c5\uff0c\u7b2c\u4e94\u5b66\u671f\u671f\u672b\u8003\u8bd5\u662f\u5bd2\u5047\u56de\u6765\u8003\u7684\uff0c\u5728\u5bb6\u7684\u65f6\u5019\u5c31\u75af\u72c2\u590d\u4e60\u3002\u6700\u7ec8\u524d\u4e94\u5b66\u671f\u6210\u7ee9\u662f2/47\u3002</p> <p>\u5927\u4e09\u4e0b\u5b66\u671f\u521a\u5f00\u59cb\u975e\u5e38\u95f2\uff0c\u6bcf\u5929\u7126\u8651\u6295\u4ec0\u4e48\u5b66\u6821\uff0c\u600e\u4e48\u51c6\u5907\u590d\u8bd5\uff0c\u600e\u4e48\u5199\u4e2a\u4eba\u9648\u8ff0\u3001\u7b80\u5386\u3001\u63a8\u8350\u4fe1\u3001\u53c2\u8425\u8bba\u6587\u3002\u5f53\u65f6\u4eceb\u7ad9\u4e0a\u770b\u4e86\u4e00\u70b9\u522b\u4eba\u7684\u7ecf\u9a8c\uff0c\u90fd\u8bd5\u4e86\u4e00\u4e0b\u9009\u62e9\u4e86\u9002\u5408\u81ea\u5df1\u7684\u590d\u8bd5\u51c6\u5907\u65b9\u5f0f\u51c6\u5907\u4e86\u4e00\u6bb5\u65f6\u95f4\u3002\u540e\u6765\u51b3\u5b9a\u5148\u51c6\u5907\u53c2\u8425\u8bba\u6587\uff0c\u6574\u4e2a\u4e94\u4e00\u770b\u4e86\u4e94\u5929\u7684\u6587\u732e\u3002\u540e\u6765\u4e0a\u4ea4\u590f\u4ee4\u8425\u7b80\u7ae0\u7387\u5148\u53d1\u51fa\uff0c\u903c\u7740\u6211\u5b8c\u6210\u4e86\u4e2a\u4eba\u9648\u8ff0\u3001\u63a8\u8350\u4fe1\u3001\u8bc1\u4ef6\u7167\u3001\u5404\u7c7b\u8bc1\u4e66\u626b\u63cf\u4ef6\uff0c\u82b1\u4e00\u5929\u7684\u65f6\u95f4\u6295\u5b8c\u4e86\u7b2c\u4e00\u6240\u5b66\u6821\u3002</p> <p>\u540e\u9762\u5c31\u662f\u51c6\u5907\u6295\u9012\u548c\u53c2\u8425\u3002\u51c6\u5907\u53c2\u8425\u8bba\u6587\u5fc3\u529b\u4ea4\u7601\uff0c\u6bcf\u5929\u8981\u590d\u4e60\u51c6\u5907\u4e13\u4e1a\u8bfe\u7684\u5404\u79cd\u671f\u4e2d\u8003\u8bd5\uff0c\u8981\u82b1\u65f6\u95f4\u548c\u5fc3\u601d\u6295\u9012\u5f88\u5927\u7a0b\u5ea6\u4e0d\u4f1a\u5165\u8425\u7684\u5b66\u6821\uff0c\u51c6\u5907\u5404\u79cd\u6750\u6599\uff0c\u8dd1\u6559\u52a1\u5904\u7ed9\u6750\u6599\u76d6\u7ae0\u3002\u8fd9\u4e00\u6bb5\u65f6\u95f4\u7761\u7720\u65f6\u95f4\u975e\u5e38\u5c11\uff0c\u7ecf\u5e38\u4e00\u4e24\u70b9\u7761\uff0c\u4e94\u516d\u70b9\u8d77\uff0c\u6700\u7d2f\u7684\u662f\u671f\u672b\u8003\u8bd5\u7684\u65f6\u5019\uff0c\u4e24\u70b9\u534a\u7761\uff0c\u4e09\u70b9\u534a\u8d77\uff0c\u751a\u81f3\u7ecf\u5386\u4e86\u4eba\u751f\u7b2c\u4e00\u6b21\u901a\u5bb5\u590d\u4e60\u5b8c\u4e00\u95e8\u4e13\u4e1a\u8bfe\u3002</p> <p>\u6700\u503c\u5f97\u4e00\u63d0\u7684\u662f\uff0c\u6211\u5728\u505a\u8fd9\u4e9b\u4e8b\u60c5\u65f6\uff0c\u820d\u53cb\u4e5f\u505a\u7740\u540c\u6837\u7684\u4e8b\u60c5\uff0c\u6211\u4eec\u6709\u4e8b\u4e92\u76f8\u5546\u91cf\u3002\u5982\u679c\u6ca1\u6709\u820d\u53cb\uff0c\u6211\u53ef\u80fd\u575a\u6301\u4e0d\u4e0b\u53bb\u6295\u8fd9\u4e48\u591a\u5b66\u6821\u3002</p>"},{"location":"experience/ielts/","title":"\u96c5\u601d\u5907\u8003\u7ecf\u9a8c\u8d34","text":""},{"location":"experience/ielts/#_2","title":"\u542c\u529b","text":"<p>\u521a\u5f00\u59cb\u7ec3\u7684\u65f6\u5019\u5bf9\u542c\u529b\u7684\u6001\u5ea6\u662f\u7eaf\u6446\u70c2\uff0c\u5e38\u6001\u662f5.5\u3002\u56e0\u4e3a\u81ea\u5df1\u542c\u529b\u4e00\u76f4\u4e0d\u597d\uff0c\u4e5f\u4e0d\u77e5\u9053\u600e\u4e48\u7ec3\u3002\u7136\u540e\u6709\u4e00\u5929\u548c\u670b\u53cb\u5410\u69fd\uff0c\u670b\u53cb\u82f1\u8bed\u4e13\u4e1a\u7684\uff0c\u8bf4\u542c\u529b\u5f88\u5bb9\u6613\u63d0\u9ad8\uff0c\u5c31\u662f\u505a\u542c\u5199\u3002\u4f46\u662f\u6211\u60f3\u81ea\u5df1\u6ca1\u6709\u8db3\u591f\u7684\u65f6\u95f4\uff0c\u5c31\u51c6\u5907\u7528\u8ddf\u8bfb\u4ee3\u66ff\u542c\u5199\u3002\u6240\u4ee5\u5bf9\u4e8e\u542c\u529b\uff0c\u6211\u5c31\u662f\u6bcf\u5929\u4e00\u5957\u9898\uff0c\u7136\u540e\u7b2c\u4e8c\u5929\u505a\u8ddf\u8bfb\uff08\u6ca1\u6709\u5728\u5f53\u5929\u662f\u56e0\u4e3a\u505a\u5b8c\u9898\u57fa\u672c\u5c31\u6ca1\u65f6\u95f4\u505a\u8ddf\u8bfb\u4e86\uff09\uff0c\u5c31\u662f\u542c\u4e00\u6bb5\u5c1d\u8bd5\u542c\u61c2\u548c\u8bb0\u5fc6\uff0c\u7136\u540e\u81ea\u5df1\u5ff5\u51fa\u6765\uff0c\u5ff5\u4e0d\u51fa\u6765\u5c31\u91cd\u590d\u542c\uff0cpart1-4\u5168\u505a\u4e0b\u6765\u8981\u82b14-5\u4e2a\u5c0f\u65f6\uff0c\u4e2d\u95f4\u78b0\u5230\u4e0d\u4f1a\u7684\u5355\u8bcd\u79ef\u7d2f\u5728excel\u8868\u683c\u91cc\uff0c\u6211\u603b\u5171\u79ef\u7d2f\u4e862000\u591a\u4e2a\u3002\u8fd9\u6837\u5f88\u8d39\u65f6\u95f4\uff0c\u4f46\u5f88\u6709\u7528\uff0c\u800c\u4e14\u53ef\u4ee5\u7ec3\u53e3\u8bed\uff0c\u770b\u4ed6\u4eec\u8bf4\u8bdd\u4e60\u60ef\u662f\u4ec0\u4e48\uff0c\u6bd4\u5982\u6211\u5c31\u53d1\u73b0\u4ed6\u4eec\u559c\u6b22\u8bf4sb doing xxxxx\u540e\u9762\u8ddf\u4e00\u5927\u957f\u4e32\uff0c\u5168\u662f\u7528\u8fd9\u79cd\u73b0\u5728\u5206\u8bcd\u6765\u63cf\u8ff0\u3002</p> <p>\u5177\u4f53\u5237\u9898\u6211\u5c31\u662f\u5237\u7684\u5251\u96c5\u771f\u98988-18\uff0c19\u8003\u524d\u4e00\u5468\u6a21\u62df\u7684\u65f6\u5019\u5237\uff0c\u6ca1\u500d\u901f\u8fc7\u3002\u7136\u540e\u6211\u53c8\u53bb\u5237\u540c\u684c\u82f1\u8bed\uff0c\u65b0\u8d26\u53f7\u767b\u5f55\u5c31\u67097\u5929\u4f1a\u5458\uff0c\u7528\u522b\u4eba\u7684\u624b\u673a\u53f7\u548c\u81ea\u5df1\u7684\u624b\u673a\u53f7\u8585\u4e86\u4e00\u4e2a\u6708\u7684\u7f8a\u6bdb\u3002\u5230\u8003\u524d\u7684\u4e24\u5468\u6211\u53c8\u53bb\u5237\u52515\u30016\uff0c\u90a3\u4e2a\u901f\u5ea6\u5f88\u5feb\u4e14\u662fno more than three words\u6211\u62ff\u6765\u7ec3\u5fc3\u6001\u7684\u3002\u8003\u8bd5\u4e4b\u524d\u7684\u65e9\u4e0a\u6211\u53c8\u968f\u4fbf\u505a\u4e86\u4e24\u5957\u540c\u684c\u82f1\u8bed\u7684\u542c\u529b\u9002\u5e94\u4e00\u4e0b\uff0c\u592a\u7d27\u5f20\u4e86\u4ec0\u4e48\u4e5f\u542c\u4e0d\u5230\u3002\u4f46\u8003\u573a\u78b0\u5230\u7684\u9898\u611f\u89c9\u548c\u5251\u96c5\u96be\u5ea6\u5dee\u4e0d\u591a\uff0c\u8bed\u901f\u4f30\u8ba1\u662f\u5251\u96c5\u76841.1\u30011.2\u500d\u8fd9\u6837\uff0c\u800c\u4e14\u586b\u7a7a\u90fd\u662fno more than one word\uff0c\u5f88\u7b80\u5355\u7684\u9898\u76ee\u3002</p>"},{"location":"experience/ielts/#_3","title":"\u9605\u8bfb","text":"<p>\u6211\u4e5f\u6ca1\u770b\u4ec0\u4e48\u5e73\u884c\u9605\u8bfb\u6cd5\uff0c\u6ca1\u80cc\u540c\u4e49\u66ff\u6362\uff0c\u5c31\u76f4\u63a5\u5237\u9898\u4e86\uff0c\u505a\u9898\u65f6\u5019\u4f1a\u5927\u6982\u6807\u51fa\u81ea\u5df1\u4e0d\u4f1a\u7684\u8bcd\uff0c\u8003\u540e\u67e5\u5b8c\u79ef\u7d2f\u5728excel\u91cc\u3002\u524d\u671f\u5237\u9605\u8bfb\u7684\u65f6\u5019\u7ecf\u5e38\u505a\u4e0d\u5b8c\uff0c\u7b80\u5355\u9898\u7d27\u7d27\u5df4\u5df4\uff0c\u4e00\u96be\u5c31\u505a\u4e0d\u5b8c\uff0c\u800c\u4e14\u6211\u505a\u9605\u8bfb\u7ecf\u5e38\u65e0\u6cd5\u96c6\u4e2d\u6ce8\u610f\u529b\uff0c\u5f88\u75db\u82e6\u3002\u521a\u5f00\u59cb\u5237\u5b8c\u4e86\u5251\u96c5\u771f\u98988-18\u6211\u5c31\u53bb\u540c\u684c\u82f1\u8bed\u5237\uff0c\u540c\u684c\u82f1\u8bed\u5168\u662f\u5f88\u96be\u7684\u8bcd\u6c47\uff0c\u7ecf\u5e38\u80fd\u5f976.5\u5206\u3002\u6240\u4ee5\u6211\u4e00\u76f4\u5f88\u62c5\u5fc3\u9605\u8bfb\uff0c\u540e\u9762\u8003\u524d\u4e24\u5468\u7684\u65f6\u5019\uff0c\u56e0\u4e3a\u5f88\u7d27\u5f20\u5728\u505a\u4e00\u5957\u9605\u8bfb\u7684\u65f6\u5019\uff0c\u53d1\u73b0\u4e5f\u770b\u4e0d\u61c2\uff0c\u6211\u5c31\u53bb\u627e\u5173\u952e\u8bcd\uff0c\u53d1\u73b0\u867d\u7136\u6587\u672c\u5f88\u96be\uff0c\u6211\u4e5f\u4e0d\u77e5\u9053\u5728\u8bb2\u4ec0\u4e48\uff0c\u4f46\u662f\u7b54\u6848\u51fa\u73b0\u7684\u5730\u65b9\u4e0d\u96be\uff0c\u800c\u4e14\u5f88\u5feb\u5c31\u505a\u5b8c\u4e86\uff0c\u5206\u6570\u4e5f\u4e0d\u9519\uff0c\u6211\u624d\u610f\u8bc6\u5230\u9605\u8bfb\u5176\u5b9e\u4e0d\u7528\u5c1d\u8bd5\u770b\u61c2\u3002\u5c31\u662f\u5148\u770b\u9009\u62e9\u9898\u3001\u5224\u65ad\u9898\u3001\u5339\u914d\u9898\u9898\u5e72\uff0c\u7136\u540e\u4e00\u6bb5\u4e00\u6bb5\u7684\u770b\uff0c\u770b\u4e00\u6bb5\u770b\u770b\u6709\u54ea\u4e9b\u9898\u80fd\u505a\uff0c\u5047\u5982\u4e00\u6bb5\u770b\u4e86\u4e00\u534a\u611f\u89c9\u4f3c\u4e4e\u8fd9\u6bb5\u91cc\u6ca1\u6709\u9898\u53ef\u4ee5\u505a\u4e86\uff0c\u5269\u4e0b\u7684\u5c31\u4e0d\u7528\u770b\u4e86\u3002\u8003\u573a\u7684\u9605\u8bfb\u96be\u5ea6\u548c\u525119\u5dee\u4e0d\u591a\u3002</p>"},{"location":"experience/ielts/#_4","title":"\u5199\u4f5c","text":"<p>\u5199\u4f5c\u5176\u5b9e\u6211\u4e00\u76f4\u5f88\u7126\u8651\uff0c\u4f46\u6211\u89c9\u5f97\u6700\u91cd\u8981\u7684\u5c31\u662f\u6a21\u677f\u3002\u5c0f\u4f5c\u6587\u6211\u662f\u770b\u4e86simon\u7684\u7f51\u8bfe\uff0c\u77e5\u9053\u600e\u4e48\u5199\uff0c\u80cc\u4e86\u4fbf\u4fbf\u7684\u5c0f\u4f5c\u6587\u7b14\u8bb0\uff0c\u79ef\u7d2f\u4e86\u4e00\u4e9b\u8868\u8fbe\uff0c\u7136\u540e\u5206\u6790\u4e86simon\u7684\u5341\u51e0\u7bc7\u8303\u6587\uff0c\u79ef\u7d2f\u4e86\u4e00\u4e9b\u8868\u8fbe\uff0c\u81ea\u5df1\u53ef\u80fd\u7ec3\u4e86\u5341\u51e0\u7bc7\u3002\u6211\u7ec3\u7684\u6bd4\u8f83\u591a\u7684\u662f\u56fe\u8868\uff0c\u6d41\u7a0b\u56fe\u548c\u5730\u56fe\u4e0d\u591a\uff0c\u4f46\u662f\u597d\u5728\u8003\u8bd5\u5c31\u8003\u4e86\u4e00\u4e2a\u7b80\u5355\u7684\u67f1\u72b6\u56fe\u3002</p> <p>\u5927\u4f5c\u6587\u6211\u662f\u770b\u4e86\"\u5de8\u9760\u8c31\u7684\u9f9a\u540c\u5b66\"\u603b\u7ed3\u7684simon\u7684\u7f51\u8bfe\u7b14\u8bb0\uff0c\u77e5\u9053\u6bcf\u79cd\u7c7b\u578b\u4f60\u53ef\u4ee5\u7ed9\u4ec0\u4e48\u6837\u7684\u89c2\u70b9\uff0c\u6211\u4e2a\u4eba\u89c9\u5f97\u4e24\u8fb9\u90fd\u6709\u9053\u7406\uff0c\u66f4\u540c\u610f\u5176\u4e2d\u4e00\u8fb9\u7684\u6bd4\u8f83\u4fdd\u9669\uff0c\u56e0\u4e3a\u4e00\u8fb9\u5012\u7684\u4e0d\u597d\u5199\uff0c\u800c\u4e14\u8003\u5b98\u5bf9\u4e8e\u4e00\u8fb9\u5012\u7684\u8bba\u8bc1\u4f30\u8ba1\u5f88\u8c28\u614e\u3002\u7136\u540e\u6211\u53c8\u80cc\u4e86simon\u7684\u5927\u4f5c\u6587\u8303\u6587\uff0c\u80cc\u4e86\u670925\u7bc7\uff0c\u5927\u4f5c\u6587\u89c2\u70b9\u5e93\u4e5f\u80cc\u5b8c\u4e86\uff0c\u4f46\u8fd8\u662f\u4ec0\u4e48\u90fd\u4e0d\u4f1a\u5199\u3002\u8fd9\u4e2a\u65f6\u671f\u6211\u5e76\u4e0d\u592a\u77e5\u9053\u5982\u4f55\u53bb\u5bf9\u4e8e\u4e00\u4e2a\u89c2\u70b9\u62ff\u4e00\u6bb5\u6765\u8bba\u8bc1\uff0c\u4e00\u822c\u90fd\u7528firstly, secondly, thirdly\u7684\u7ed3\u6784\uff0c\u6bcf\u6bb5\u4e09\u4e2a\u89c2\u70b9\uff0c\u8bba\u8bc1\u5f88\u5c11\uff0c\u8ba9deepseek\u8bc4\u5206\u57286-6.5\u5de6\u53f3\u3002\u7136\u540e\u6211\u770b\u4e86\u675c\u4ed5\u660e\u7684\u7b14\u8bb0\uff0c\u77e5\u9053\u90a3\u79cdstatement-explanation-example-concession\u7684\u6bb5\u5185\u8bba\u8bc1\u7ed3\u6784\uff0c\u7136\u540e\u82b1\u5dee\u4e0d\u591a\u4e00\u5468\u7684\u65f6\u95f4\u770b\u5b8c\u4e86\u614e\u5c0f\u5db7\u300a\u5341\u5929\u7a81\u7834\u96c5\u601d\u5b8c\u6574\u771f\u9898\u5e93\u4e0e6-9\u5206\u8303\u6587\u300b\uff0c\u770b\u7684\u65f6\u5019\u5bf9\u4e8e\u4e00\u4e9b\u8bba\u8bc1\u89c2\u70b9\u548c\u8bcd\u6c47\u505a\u4e86\u8bb0\u5fc6\uff0c\u611f\u89c9\u8fd9\u4e2a\u5bf9\u6211\u6700\u6709\u7528\uff0c\u56e0\u4e3a\u4ed6\u53ef\u4ee5\u8ba9\u6211\u5728\u77ed\u65f6\u95f4\u5185\u4e86\u89e3\u6bcf\u4e2a\u4e3b\u9898\u5927\u6982\u4f1a\u6709\u54ea\u4e9b\u9898\u76ee\uff0c\u90fd\u53ef\u4ee5\u600e\u4e48\u8bba\u8bc1\u3002\u770b\u5b8c\u8fd9\u4e2a\u518d\u5199\u5927\u4f5c\u6587\uff0cdeepseek\u5c31\u53ef\u4ee5\u7ed9\u62117\u4e86\u3002</p> <p>\u4f5c\u6587\u5176\u5b9e\u8f93\u5165\u6700\u91cd\u8981\uff0c\u8003\u524d\u7ec3\u51e0\u7bc7\u63a7\u5236\u65f6\u95f4\u5c31\u884c\uff0c\u4e0d\u7528\u5199\u592a\u591a\u3002</p>"},{"location":"experience/ielts/#_5","title":"\u53e3\u8bed","text":"<p>\u6211\u53e3\u8bed\u5c31\u662f\u6bcf\u5929\u90fd\u548c\u8eab\u8fb9\u7684\u4eba\u7528\u82f1\u8bed\u8bf4\u8bdd\uff0c\u5c31\u662f\u5927\u80c6\u53bb\u8bf4\uff0c\u628a\u4ed6\u4eec\u5f53\u5916\u56fd\u4eba\u5c31\u6562\u5f00\u53e3\u4e86\u3002\u7136\u540e\u6211\u4e00\u76f4\u4e0d\u77e5\u9053part2\u662f\u600e\u4e48\u4e32\u9898\uff0c\u7136\u540e\u770b\u4e86\u5c0f\u7ea2\u4e66\"\u54ce\u561bkt\u732b\u554a\"\u7684\u5e16\u5b50\u300a\u5b9d\u5b9d\u5982\u679c\u4f60\u53ea\u67091\u5929\u51c6\u5907\u96c5\u601d\u53e3\u8bedp2\u300b\u7136\u540e\u5c31\u5b89\u5fc3\u5f88\u591a\uff0c\u51c6\u5907\u4e86\u4e00\u4e2a\u4eba\uff0c\u4e00\u4e2a\u7269\uff0c\u7136\u540e\u4e00\u6b21\u65c5\u884c\u8fdb\u884c\u4e32\u9898\u3002\u540e\u9762\u53d1\u73b0\u5176\u5b9e\u4e32\u7684\u8fd8\u662f\u5f88\u6162\uff0c\u4f46\u4e3b\u8981\u662f\u5f88\u5b89\u5fc3\u4e86\u3002\u53e3\u8bed\u4e3b\u8981\u662f\u591a\u7ec3\uff0c\u6211\u8003\u524d\u4e00\u5468\u7528\u4e86\u4e00\u665a\u4e0a\u7ec3\u5b8c\u4e86p1\u7684\u9898\u5e93\uff0c\u7528\u4e86\u4e00\u665a\u4e0a\u7ec3\u4e86p2\u4e00\u534a\u7684\u9898\u5e93\uff0cp3\u5c31\u662f\u627e\u4e86\u6512\u4eba\u54c1\u5e16\u5b50\uff0c\u5bf9\u6700\u8fd1\u7684\u51e0\u4e2a\u9898\u5c1d\u8bd5\u7ec3\u4e86\u4e00\u4e0b\u3002\u8003\u8bd5\u662f\u4e0b\u53483\u70b9\u591a\uff0c\u4e2d\u5348\u5403\u5b8c\u5348\u996d\u6211\u53c8\u75283\u4e2a\u5c0f\u65f6\u7684\u65f6\u95f4\u7ec3\u5b8c\u4e86p2\u7684\u5269\u4e0b\u4e00\u534a\uff0c\u7ec3\u4e86\u4e24\u4e2a\u6512\u4eba\u54c1\u7684\u9898\u76ee\u5c31\u53bb\u8003\u4e86\u3002\u8003\u7684\u65f6\u5019\u8bf4\u7684\u5f88\u5feb\uff0c\u8bed\u6cd5\u9519\u8bef\u4e71\u98de\u3002\u8003\u5b98\u662fbase\u897f\u5b89\u7684\u767d\u7537\uff0c\u5168\u7a0b\u65e0\u8868\u60c5\uff0c\u53ea\u6709\u5728\u6211\u5728\u80e1\u8bf4\u516b\u9053\u7684\u65f6\u5019\u6253\u65ad\u4e86\u6211\u4e00\u4e24\u6b21\u3002</p>"},{"location":"friends/","title":"\u53cb\u94fe","text":"<p>\u5f85\u8865\u5145</p>"}]}